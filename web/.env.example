# Copy to web/.env, then FILL IN the three empty values below before starting.
#
# 这个文件里的密钥项是**空的**，照抄它直接 `docker compose up` 会启动失败并告诉你
# 缺什么。以前这里带着一组可用的默认值（dev-only-change-me-…），配合
# OCIBOT_REQUIRE_SECURE_SECRETS=0，等于文档教人把一台面板跑在「公开仓库里人人可见
# 的主密钥」上 —— 而主密钥只经一次 SHA-256 派生 Fernet 密钥，谁拿到数据库就能解开
# 每一个租户的 OCI 私钥。宁可起不来，也不要能起来。
#
# 生成方法（三条都要）：
#     printf 'OCIBOT_MASTER_KEY=%s\n' "$(openssl rand -hex 48)" >> web/.env
#     printf 'OCIBOT_JWT_SECRET=%s\n' "$(openssl rand -hex 48)" >> web/.env
#     printf 'POSTGRES_PASSWORD=%s\n' "$(openssl rand -hex 16)" >> web/.env
#     chmod 600 web/.env
# （`scripts/install.sh install` 会自动做这些，并且以 0600 创建文件。）
#
# Production (Docker Compose) always uses PostgreSQL — DATABASE_URL is injected
# by docker-compose.yml. Local dev without Docker may keep SQLite by omitting it.

# IMPORTANT: docker compose resolves ${VAR} interpolation from a .env in the
# PROJECT directory, NOT from a service's env_file. POSTGRES_PASSWORD is used via
# interpolation, so this value only reaches the database if the repo root has a
# .env too. scripts/install.sh links it for you:
#     ln -s web/.env .env
# 少了这个链接，compose 现在会直接报「POSTGRES_PASSWORD 未设置」并停下 —— 以前是
# 悄悄回落到内置默认密码 ocibot_dev_pass，一台看起来正常的面板背后是一个所有人都
# 知道密码的数据库。
# Changing it later does NOT rotate an existing volume (POSTGRES_PASSWORD only
# applies at initdb) — run:
#     docker compose exec db psql -U ocibot -c "ALTER USER ocibot WITH PASSWORD '...';"
POSTGRES_PASSWORD=

# Long random strings — REQUIRED for encrypting OCI private keys & signing JWTs.
# 至少 24 字符，建议 `openssl rand -hex 48`（96 字符）。
# NOTE: rotating OCIBOT_MASTER_KEY makes existing encrypted private keys
# undecryptable (you must re-import tenants / restore from a ZIP backup).
OCIBOT_MASTER_KEY=
OCIBOT_JWT_SECRET=

# 密钥仍是内置默认值、或短于 24 字符时拒绝启动。任何联网可达的部署都必须是 1。
# 空值也会被它挡下（长度检查），所以上面两行留空 = 起不来，这是故意的。
OCIBOT_REQUIRE_SECURE_SECRETS=1

# Comma-separated browser origins allowed by CORS. Must be exact: a literal "*"
# is IGNORED, because wildcard + cookie credentials makes Starlette reflect the
# caller's Origin, which would let any website read this API as the logged-in
# user. Keep this to the origins you actually serve the panel on, e.g.:
#   OCIBOT_CORS_ORIGINS=https://ocibot.example.com
# Add http://localhost:5173 only while running the Vite dev server.
OCIBOT_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Auth cookie flags. Set COOKIE_SECURE=1 when serving over HTTPS so the JWT
# cookie is TLS-only. SameSite: lax | strict | none (none requires secure).
OCIBOT_COOKIE_SECURE=0
OCIBOT_COOKIE_SAMESITE=lax

# Reject POST/PUT/PATCH/DELETE whose Origin is not this host. SameSite alone is
# not enough: `none` disables it outright, and cookies are shared across a whole
# SITE, so another host under your domain can post to the panel with the victim's
# session. Leave this at 1.
#
# It only turns off if a reverse proxy rewrites Host to the upstream name AND
# does not send X-Forwarded-Host — the fix for that is to add the public origin
# to OCIBOT_CORS_ORIGINS above, not to disable the check. The 403 body says so.
OCIBOT_ORIGIN_CHECK=1

# Audit log retention. Failed logins are recorded, so unauthenticated traffic
# writes rows and an attacker decides how many: without a ceiling a
# credential-stuffing run fills the disk. Both limits apply, 0 disables one.
# Pruning happens in the worker heartbeat (database only, never Oracle).
OCIBOT_AUDIT_RETENTION_DAYS=180
OCIBOT_AUDIT_MAX_ROWS=50000

# Registration policy. The FIRST user may always self-register and becomes the
# admin. After that registration is CLOSED by default.
OCIBOT_ALLOW_OPEN_REGISTRATION=0

# JWT lifetime in minutes (default 720 = 12h).
OCIBOT_JWT_EXPIRE_MINUTES=720

# Trust X-Forwarded-For / X-Real-IP only when behind a reverse proxy that
# overwrites those headers. Leave 0 if clients can hit the app directly:
# with this on, a client that can reach the app directly can forge its own
# rate-limit identity and brute-force logins unthrottled.
OCIBOT_TRUST_PROXY=0

# Which peers uvicorn accepts proxy headers from (only used when TRUST_PROXY=1).
# Defaults to loopback. Set to your reverse proxy's address/CIDR, e.g. the Docker
# bridge network 172.18.0.0/16. Never "*" on a publicly reachable port.
# OCIBOT_FORWARDED_ALLOW_IPS=127.0.0.1,::1

# Host interface the published container port binds to. Set 127.0.0.1 when a TLS
# reverse proxy fronts the panel so the plain-HTTP port is not exposed.
# OCIBOT_BIND=0.0.0.0

# ---------------------------------------------------------------- 访问方式
# The five keys above plus these two are written as a SET by
# `scripts/install.sh domain <域名>` / `scripts/install.sh ip`. Prefer that over
# editing them by hand: they only make sense together. COOKIE_SECURE=1 without
# TLS in front means the browser never returns the session cookie ("logged out
# immediately after logging in"); TRUST_PROXY=1 without a proxy lets any client
# declare its own rate-limit identity.
#
# COMPOSE_PROFILES=tls starts the bundled Caddy container (deploy/Caddyfile),
# which terminates HTTPS on 80/443 and issues/renews the certificate itself.
# Empty means no HTTPS front end — the panel is reached at http://IP:PORT.
# COMPOSE_PROFILES=

# Public domain, used by the Caddy container as its site address and by
# CORS_ORIGINS. Only meaningful together with COMPOSE_PROFILES=tls.
# OCIBOT_DOMAIN=

# ------------------------------------------------------- 面板内一键更新（默认关）
# 这一项现在只是「install.sh 要不要叠加 docker-compose.update.yml」的选择器；
# 容器里真正的开关由那个文件给出，两者绑在一起，不会再出现「开关关着但
# docker.sock 照样挂进容器」的情况（那是 0.4.80 之前的行为）。
#
# 开启后 API 容器以 root 运行、持有宿主机 docker.sock 和可写的仓库目录（目录里
# 就有这个文件），执行更新时还会进宿主机命名空间 —— **任何一个管理员会话，或
# API 进程里任何一处代码执行，都等于宿主机 root**。
#
# 用命令改，不要手改这一行（手改不会重建容器）：
#     bash scripts/install.sh update-on     # 打开
#     bash scripts/install.sh update-off    # 关闭
OCIBOT_UPDATE_ENABLED=0

# ------------------------------------------------------------- 基础镜像钉版（推荐）
# 留空时用可变标签（node:22-alpine 等），而 `install.sh update` 每次都
# `compose build --pull`，也就是每次更新都拉一遍「现在的」那一份内容。钉成 digest
# 之后更新才是可复现的。取值：docker buildx imagetools inspect <标签>
#
# 写在这里而不是改 Dockerfile：更新会 git reset --hard，改仓库文件活不过一次更新。
# OCIBOT_NODE_IMAGE=node:22-alpine@sha256:...
# OCIBOT_PYTHON_IMAGE=python:3.12-slim@sha256:...
# OCIBOT_POSTGRES_IMAGE=postgres:16-alpine@sha256:...
# OCIBOT_CADDY_IMAGE=caddy:2-alpine@sha256:...
# OCIBOT_DOCKER_CLI_IMAGE=docker:27-cli@sha256:...

# Master switch for the worker's background Oracle calls. Since 0.4.36 that is
# capacity retry alone, and it only runs while a job exists — so leaving this on
# costs nothing until you create one. Set to 0 to guarantee the panel touches OCI
# only while somebody is using it.
#
# NOTE: 0 does not hide capacity retry — it stops it EXECUTING; a job will sit idle
# forever. The panel says so on the task page and in the sidebar so this is not
# mistaken for a bug.
OCIBOT_WORKER_BACKGROUND_OCI=1

# Performance tuning (Docker)
OCIBOT_API_WORKERS=2
OCIBOT_DB_POOL_SIZE=10
OCIBOT_DB_MAX_OVERFLOW=20
OCIBOT_PORT=8000
