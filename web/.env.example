# Copy to web/.env and change all secrets before production use.

POSTGRES_PASSWORD=ocibot_dev_pass_change_me

# Long random strings — required for encrypting OCI private keys & JWT
OCIBOT_MASTER_KEY=dev-only-change-me-ocibot-web-master-key-please-rotate
OCIBOT_JWT_SECRET=dev-only-jwt-secret-change-me-please-rotate

# Comma-separated browser origins allowed by CORS
OCIBOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# First user can register freely; set false after bootstrap if desired
# (controlled in Settings.allow_open_registration — default true)
